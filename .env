# ==========================================
# POSTGRES CONFIGURATION (4 ISOLATED DATABASES)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_PORT=5432

# Database Connection URLs for Microservices
IDENTITY_DB_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/identity_db
STUDY_DB_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/study_governance_db
CLINICAL_DB_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/clinical_safety_db
AUDIT_DB_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/audit_integrity_db

# ==========================================
# REDIS CONFIGURATION (STREAMS & CACHE)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# MINIO CONFIGURATION (S3 OBJECT STORAGE)
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=aiia-trial-documents

# ==========================================
# KEYCLOAK CONFIGURATION (AUTH & RBAC)
# ==========================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=adminpassword
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=aiia-ctms
KEYCLOAK_CLIENT_ID=aiia-web-client